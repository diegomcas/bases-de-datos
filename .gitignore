# ==========================================================================
#  Qué NO se publica
#
#  Este repositorio es público y se sirve por GitHub Pages. Todo lo que se
#  versiona queda accesible en internet, y el historial de git conserva lo
#  que alguna vez se subió aunque después se borre.
#
#  Antes de agregar algo nuevo, preguntarse si puede leerlo cualquiera.
# ==========================================================================


# --- Datos personales de estudiantes. Nunca. -----------------------------
Alumnos/
TP/
Examenes/
respuesta_yolanda.txt


# --- Material docente: claves, exámenes y guiones ------------------------
_docente/

