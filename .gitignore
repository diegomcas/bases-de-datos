# plantilla de la EIS y el nombre de la Jefa de Departamento. No es material
# propio y no se publica sin su acuerdo.
descargas/programa-analitico.pdf


# --- Versiones anteriores y duplicados -----------------------------------
# El historial de git ya cumple esta función.
_archivo/
_backup/


# --- Credenciales ---------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
credenciales*
secretos*


